close all
clear
clc

%% Medidas de los eslabones
l1 = input('Indica el tamano del primer eslabon: ');
l2 = input('Indica el tamano del segundo eslabon: ');
l3 = input('Indica el tamano del tercer eslabon: ');

rx1 = input('Eslabon 1 - angulo en X [rad]: ');
ry1 = input('Eslabon 1 - angulo en Y [rad]: ');
rz1 = input('Eslabon 1 - angulo en Z [rad]: ');

rx2 = input('Eslabon 2 - angulo en X [rad]: ');
ry2 = input('Eslabon 2 - angulo en Y [rad]: ');
rz2 = input('Eslabon 2 - angulo en Z [rad]: ');

rx3 = input('Eslabon 3 - angulo en X [rad]: ');
ry3 = input('Eslabon 3 - angulo en Y [rad]: ');
rz3 = input('Eslabon 3 - angulo en Z [rad]: ');

N = 50; % pasos de la animacion

% --- Trayectorias angulares: de 0 al angulo final, en N pasos ---
rx1_vec = linspace(0, rx1, N); ry1_vec = linspace(0, ry1, N); rz1_vec = linspace(0, rz1, N);
rx2_vec = linspace(0, rx2, N); ry2_vec = linspace(0, ry2, N); rz2_vec = linspace(0, rz2, N);
rx3_vec = linspace(0, rx3, N); ry3_vec = linspace(0, ry3, N); rz3_vec = linspace(0, rz3, N);

figure
for k = 1:N
    clf
    hold on
    grid on
    axis equal
    axis([-1.5 1.5 -1.5 1.5 -1.5 1.5])
    view(3)
    xlabel('X'); ylabel('Y'); zlabel('Z');
    title('Brazo robotico de 3 eslabones en 3D (Rotacion3D)');

    % --- Ejes de referencia ---
    line([0 1.5], [0 0], [0 0], 'Color', 'red',   'LineWidth', 1.5);
    line([0 0], [0 1.5], [0 0], 'Color', 'green', 'LineWidth', 1.5);
    line([0 0], [0 0], [0 1.5], 'Color', 'blue',  'LineWidth', 1.5);

    % --- Vectores locales de cada eslabon, en coordenadas homogeneas ---
    v1 = [l1; 0; 0; 1];
    v2 = [l2; 0; 0; 1];
    v3 = [l3; 0; 0; 1];

    % --- Solo se rota (nunca se usa Traslacion); la posicion de cada
    %     articulacion es la anterior + el eslabon ya rotado ---
    joint0 = [0; 0; 0];

    r1 = Rotacion3D(rx1_vec(k), ry1_vec(k), rz1_vec(k), v1);
    joint1 = joint0 + r1(1:3);

    r2 = Rotacion3D(rx1_vec(k), ry1_vec(k), rz1_vec(k), ...
         Rotacion3D(rx2_vec(k), ry2_vec(k), rz2_vec(k), v2));
    joint2 = joint1 + r2(1:3);

    r3 = Rotacion3D(rx1_vec(k), ry1_vec(k), rz1_vec(k), ...
         Rotacion3D(rx2_vec(k), ry2_vec(k), rz2_vec(k), ...
         Rotacion3D(rx3_vec(k), ry3_vec(k), rz3_vec(k), v3)));
    EF = joint2 + r3(1:3);

    % --- Articulaciones ---
    scatter3(joint0(1), joint0(2), joint0(3), 100, 'filled', 'MarkerFaceColor', 'blue');
    scatter3(joint1(1), joint1(2), joint1(3), 100, 'filled', 'MarkerFaceColor', 'red');
    scatter3(joint2(1), joint2(2), joint2(3), 100, 'filled', 'MarkerFaceColor', 'red');
    scatter3(EF(1), EF(2), EF(3), 100, 'filled', 'MarkerFaceColor', 'magenta');

    % --- Eslabones ---
    line([joint0(1) joint1(1)], [joint0(2) joint1(2)], [joint0(3) joint1(3)], 'Color', 'black', 'LineWidth', 2);
    line([joint1(1) joint2(1)], [joint1(2) joint2(2)], [joint1(3) joint2(3)], 'Color', 'black', 'LineWidth', 2);
    line([joint2(1) EF(1)],     [joint2(2) EF(2)],     [joint2(3) EF(3)],     'Color', 'black', 'LineWidth', 2);

    drawnow
    pause(0.05)
end