close all
clear
clf

l1 = input("Indica el tamano del primer eslabon [m]: ");
l2 = input("Indica el tamano del segundo eslabon [m]: ");
l3 = input("Indica el tamano del tercer eslabon [m]: ");

DibujaEjes(l1+l2+l3);
view(3)
axis equal

rot_1 = input("Indica el angulo de rotacion del primer eslabon [rad]: ");
eje_1 = input("Indica el eje de rotacion del primer eslabon (x/y/z): ");
rot_2 = input("Indica el angulo de rotacion del segundo eslabon [rad]: ");
eje_2 = input("Indica el eje de rotacion del segundo eslabon (x/y/z): ");
rot_3 = input("Indica el angulo de rotacion del tercer eslabon [rad]: ");
eje_3 = input("Indica el eje de rotacion del tercer eslabon (x/y/z): ");

N = 50;
a1 = linspace(0, rot_1, N);
a2 = linspace(0, rot_2, N);
a3 = linspace(0, rot_3, N);

%Para elegir el eje
if eje_1 == 'x'
    x1 = a1; y1 = 0; z1 = 0;
elseif eje_1 == 'y'
    x1 = 0; y1 = a1; z1 = 0;
elseif eje_1 == 'z'
    x1 = 0; y1 = 0; z1 = a1;
end

if eje_2 == 'x'
    x2 = a2; y2 = 0; z2 = 0;
elseif eje_2 == 'y'
    x2 = 0; y2 = a2; z2 = 0;
elseif eje_2 == 'z'
    x2 = 0; y2 = 0; z2 = a2;
end

if eje_3 == 'x'
    x3 = a3; y3 = 0; z3 = 0;
elseif eje_3 == 'y'
    x3 = 0; y3 = a3; z3 = 0;
elseif eje_1 == 'z'
    x3 = 0; y3 = 0; z3 = a3;
end

for k = 1:N
    clf
    DibujaEjes(l1+l2+l3);
    view(3)
    axis equal
    hold on

    % Primera articulacion
    joint1 = [0 0]';
    scatter3(joint1(1), joint1(2), joint1(3), 100, 'filled', 'MarkerFaceColor', 'red');

    % Eslabon 1
    v1 = [l1 0 0 1]';
    p1 = Rotacion(x1(k), y1(k), z1(k), v1);
    joint2 = joint1 + p1(1:3);
    scatter3(joint2(1), joint2(2), joint2(3), 100, 'filled', 'MarkerFaceColor', 'red');

    % Eslabon 2 (desde la punta del anterior
    v2 = [l2 0 0 1]';
    p2 = Rotacion(x1(k), y1(k), y1(k), Rotacion(x2(k), y2(k), z2(k), v2));
    joint3 = joint2 + p2(1:3);
    scatter3(joint3(1), joint3(2), joint3(3), 100, 'filled', 'MarkerFaceColor', 'red');

    % Eslabon 3
    v3 = [l3 0 0 1]';
    p3 = Rotacion(0, 0, a1(k), Rotacion(0, 0, a2(k), Rotacion(0, 0, a3(k), v3)));
    EF = joint3 + p3(1:3);
    scatter3(EF(1), EF(2), EF(3), 100, 'filled', 'MarkerFaceColor', 'red');

    % Eslabones (lineas entre articulaciones)
    line([joint1(1) joint2(1)], [joint1(2) joint2(2)], [joint1(3) joint2(3)], 'color', 'black', 'linewidth', 2);
    line([joint2(1) joint3(1)], [joint2(2) joint3(2)], [joint(3) joint3(3)],'color', 'black', 'linewidth', 2);
    line([joint3(1) EF(1)],     [joint3(2) EF(2)],     [joint3(3) EF(3)], 'color', 'black', 'linewidth', 2);

    pause(0.05)
end